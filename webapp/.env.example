# Copy to .env.local and fill in. Never commit .env.local.
#
# Only two of these change when the app moves from the free stack to AWS:
# DATABASE_URL and NEXT_PUBLIC_VIDEO_BASE_URL. Everything else is identical either way.

# --- Database (M3+) --------------------------------------------------------
# Free stack: Neon pooled connection string, as the course_app_user role.
#   postgres://course_app_user:...@ep-xxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require
# AWS-day:    the same URL pointing at RDS. No code change.
DATABASE_URL=

# AWS-day only. Path to the RDS CA bundle; leave unset on Neon, which chains to a public CA.
# TLS verification stays on in both cases — never set rejectUnauthorized=false.
# DB_CA_BUNDLE_PATH=./certs/rds-global-bundle.pem

# --- Auth (M2+) ------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Only needed to run a PRODUCTION build locally (`next build && next start`). Auth.js already
# trusts the host under `next dev` and on Vercel; without this, local prod runs return
# UntrustedHost on every /api/auth/* call. Do not set it on a server behind an untrusted proxy.
# AUTH_TRUST_HOST=true

# The organisational boundary — the ONLY access rule that lives in env, because it changes
# ~never and must work on the edge without a database (adr/2026-08-04-08).
# Comma-separated, case-insensitive. A user must match a domain OR be listed explicitly.
# Anyone matching is auto-provisioned on first sign-in.
ALLOWED_EMAIL_DOMAINS=stackdrop.co

# Admins of last resort. Always unioned with users.is_admin, so an empty table or a bad revoke
# can never lock everyone out of /admin. Everyday admin grants happen in the UI, not here —
# changing this needs a redeploy on Vercel, which is exactly why it isn't the main mechanism.
BOOTSTRAP_ADMIN_EMAILS=

# --- Video delivery (M1+) --------------------------------------------------
# Free stack: Cloudflare R2 public bucket URL, e.g. https://pub-<hash>.r2.dev/videos
# AWS-day:    https://<distribution>.cloudfront.net/videos
NEXT_PUBLIC_VIDEO_BASE_URL=

# --- Video upload (local only; used by scripts/sync-videos.sh) -------------
# Not needed by the running app — only when pushing output/ to object storage.
VIDEO_BUCKET=
# R2 only. Unset this to target plain AWS S3.
# VIDEO_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY come from your shell or ~/.aws/credentials.
