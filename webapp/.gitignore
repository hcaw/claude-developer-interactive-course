# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# ...except the RDS CA bundle. It is a public Amazon cert and Vercel can only read it at runtime
# if it is committed (adr/2026-08-01-03). Unused while the DB is Neon, which chains to a public CA.
!certs/*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The template carries no secrets and documents what every deployment needs.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
